# 复制为 .env 后填写。.env 已被 .gitignore 排除。
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus

# 联系表单邮件发送
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
CONTACT_TO=yun@36tech.info
CONTACT_FROM=

# ---- CRESpan Demo 门禁（/crespan）----
# 留空 = 谁都能用（本地开发）；填了值 = 进页面要先输访问码。
# 想收回访问权就换一个新码，已发出的 cookie 立刻失效。
CRESPAN_ACCESS_CODE=
# 彻底下线：改成 false，页面只剩「Demo 暂未开放」，接口一律 503
CRESPAN_ENABLED=true
# 输对码后免输入的天数
CRESPAN_SESSION_DAYS=7

# ATTOM 房产数据接口（/property 测试页、/crespan 智能检索）
# /crespan 同时需要上面的 QWEN_* 三项
ATTOM_API_KEY=
# ATTOM_BASE_URL=https://api.gateway.attomdata.com/propertyapi/v1.0.0
# ATTOM_DB_PATH=data/attom.sqlite

# Express 监听端口（Vite 开发代理会跟随此项）
PORT=3100
