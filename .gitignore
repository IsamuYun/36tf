# ---- 依赖 ----
node_modules/
.pnpm-store/

# ---- 构建产物 ----
dist/
dist-ssr/
*.local

# ---- 环境变量：含 API 密钥与 SMTP 口令，绝对不要提交 ----
.env
.env.local
.env.*.local
.env.production
# .env.example 是模板，不含真实值，需要提交
!.env.example

# ---- 本地数据库：ATTOM 测试页的请求记录 ----
data/

# ---- 日志 ----
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
logs/

# ---- 进程管理 ----
.pm2/
ecosystem.config.local.js

# ---- 编辑器 / 系统 ----
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
*~

# ---- 缓存 ----
.cache/
.temp/
.vite/
coverage/

# ---- 设计参考资料 ----
# docs/design/proto 是抓取的第三方站点快照（约 15MB），仅供本地参考，不入库。
# 如需团队共享，删掉下面这行。
docs/design/
